<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_HIJRI_MOON_AR</name>
    <author>ArabSkyPedia</author>
    <authorUrl>https://arabskypedia.com</authorUrl>
    <creationDate>2026-11-25</creationDate>
    <copyright>Copyright (C) 2026 ArabSkyPedia.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>1.0.0</version>
    <description>MOD_HIJRI_MOON_AR_XML_DESCRIPTION</description>
    <namespace path="src">ArabSkyPedia\Module\HijriMoonAr</namespace>
    <updateservers>
        <server type="extension" priority="1" name="Hijri Date and Moon Phase (Arabic) Updates">https://raw.githubusercontent.com/arabskypedia2/mod-hijri-moon-ar/main/update.xml</server>
    </updateservers>
    <files>
        <folder module="mod_hijri_moon_ar">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
        <filename>mod_hijri_moon_ar.xml</filename>
        <filename>LICENSE.txt</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/mod_hijri_moon_ar.ini</language>
        <language tag="ar-AA">language/ar-AA/mod_hijri_moon_ar.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="show_illumination"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_HIJRI_MOON_AR_SHOW_ILLUMINATION_LABEL"
                    default="1"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="show_hijri_date"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_HIJRI_MOON_AR_SHOW_HIJRI_LABEL"
                    default="1"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
